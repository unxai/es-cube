{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "../../dist/preload",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node",
    "types": ["node", "electron"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["../main/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["index.ts"],
  "exclude": ["node_modules"]
}
